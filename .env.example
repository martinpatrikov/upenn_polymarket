# ─── Polymarket API (public endpoints, no auth needed for read-only) ───
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_GAMMA_HOST=https://gamma-api.polymarket.com

# ─── Rust Sidecar (local orderbook cache) ───
SIDECAR_HOST=http://localhost:8080

# ─── Avellaneda-Stoikov Parameters ───
AS_GAMMA=0.5
AS_KAPPA=40.0
AS_BASE_ORDER_SIZE=10.0
AS_MAX_INVENTORY=100.0

# ─── Fair Value Model ───
ELO_TAU_BASE=150.0
ELO_SIGMA_DAILY=10.0
SIGNAL_MAX_SHIFT=0.15

# ─── Signal Processing ───
SIGNAL_ALPHA=2.0
DECAY_HALF_LIFE_HOURS=4.0
MIN_RELEVANCE_THRESHOLD=0.15

# ─── Quote Management ───
QUOTE_REFRESH_SECONDS=30.0

# ─── Risk Parameters ───
MAX_POSITION_PCT=0.05
MAX_PORTFOLIO_EXPOSURE=0.30
STOP_LOSS_PCT=0.15

# ─── Volatility Bounds ───
MIN_SIGMA=0.01
MAX_SIGMA=0.20

# ─── Data Sources ───
NEWS_MAX_AGE_HOURS=24
POLLING_INTERVAL_SECONDS=30
TWITTER_BEARER_TOKEN=

# ─── Reddit API (optional) ───
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=polymarket-agent/1.0

# ─── Backtest ───
STARTING_BANKROLL=10000.0
FEE_RATE_BPS=0.0

# ─── Logging ───
LOG_LEVEL=INFO
