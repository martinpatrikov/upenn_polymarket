# Polymarket API (public endpoints, no auth needed for simulation)
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_GAMMA_HOST=https://gamma-api.polymarket.com

# Reddit API (optional - agent works without it)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=polymarket-agent/1.0

# Logging
LOG_LEVEL=INFO

# Risk Parameters
MAX_POSITION_PCT=0.05
KELLY_FRACTION=0.25
MIN_EDGE_TO_TRADE=0.03
